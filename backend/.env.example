# Copy to backend/.env for local development. On Render, set these in the dashboard.

# Empty = SQLite file in backend/data/exunu.db. Production: a Postgres URL (Neon / Supabase free tier), e.g.
# postgresql://user:password@ep-xxx.eu-central-1.aws.neon.tech/exunu?sslmode=require
DATABASE_URL=

# First admin account, created when the database has no user yet
ADMIN_USERNAME=admin
ADMIN_ACCESS_CODE=admin1234

# Frontend origins allowed to call the API (comma separated). *.vercel.app is always allowed.
CORS_ORIGINS=http://localhost:3000,https://ia-app-co94.vercel.app

# Telegram bot (can also be set from the app: Telegram settings)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional: AI agent answers with Gemini (otherwise deterministic answers from the strategy output)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Background jobs. On Vercel, keep both disabled and call /api/cron/tick using an external scheduler.
SCHEDULER_ENABLED=true
TELEGRAM_POLLING=true
SESSION_DAYS=30

# Required to protect /api/cron/tick; use a long random value in Vercel.
CRON_SECRET=

# Optional Vercel Telegram webhook for bot commands (/start, activation codes, etc.).
TELEGRAM_WEBHOOK_URL=https://ia-app-tawny.vercel.app/api/telegram/webhook
TELEGRAM_WEBHOOK_SECRET=
