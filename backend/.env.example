# Copy to backend/.env for local development. On Vercel/Render, set production values in the host dashboard.

# Empty = SQLite file in backend/data/exunu.db. Production: use a pooled PostgreSQL URL (Neon / Supabase), e.g.
# postgresql://user:password@ep-xxx-pooler.eu-central-1.aws.neon.tech/exunu?sslmode=require
DATABASE_URL=

# First admin account, created when the database has no user yet
ADMIN_USERNAME=admin
ADMIN_ACCESS_CODE=admin1234

# Frontend origins allowed to call the API (comma separated). *.vercel.app is always allowed.
CORS_ORIGINS=http://localhost:3000,https://liquiditydissection.app

# Telegram bot (can also be set from the app: Telegram settings)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional: AI agent answers with Gemini (otherwise deterministic answers from the strategy output)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Background jobs. On Vercel, keep both disabled and call /api/cron/tick using an external scheduler.
SCHEDULER_ENABLED=true
TELEGRAM_POLLING=true
# A login lasts this many minutes, then the app asks for the password again
SESSION_MINUTES=60

# Required to protect /api/cron/tick; use a long random value in Vercel.
CRON_SECRET=

# Vercel: Telegram webhook for the bot's commands (/start, /signal, /chart…).
TELEGRAM_WEBHOOK_URL=https://ia-app-tawny.vercel.app/api/telegram/webhook
TELEGRAM_WEBHOOK_SECRET=

# The app's public address: the bot's invitation button opens it to link a Telegram to an account.
# Default: the first https:// entry of CORS_ORIGINS.
PUBLIC_APP_URL=https://liquiditydissection.app
